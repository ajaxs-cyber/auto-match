# 复制此文件为 .env 并填入你的 API Key
# 优先使用 DeepSeek，未设置时回退到 OpenAI

# ===== DeepSeek API（推荐，性价比高）=====
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ===== OpenAI API（可选备用）=====
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# 服务器端口
PORT=3001

# 音乐生成服务（可选）
MUBERT_API_KEY=
SOUNDRAW_API_KEY=
